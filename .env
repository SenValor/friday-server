# ─── FRIDAY Backend — Environment Variables ───────────────────────────────────

# ── Gemini ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSyBhxrMTIqX-QuTxMQtbcYHUK_oJC_KdIQs

# Phase 1 — text generation
GEMINI_MODEL=gemini-2.5-flash

# Phase 2 — live/audio session
GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-latest

# ── Firebase ───────────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
FIREBASE_PROJECT_ID=friday-jarvis-fe503

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8765
ALLOWED_ORIGINS=http://localhost:3000

# ── TTS ────────────────────────────────────────────────────────────────────────
# false → TTS çağrısı hiç yapılmaz, mesaj anında gönderilir (önerilen şimdilik)
# true  → Gemini TTS WebSocket üzerinden gönderilir (gecikme ekler)
ENABLE_TTS=true
