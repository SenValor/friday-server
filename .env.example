# ─── FRIDAY Backend — Environment Variables Example ───────────────────────────
# Copy this file to .env and fill in the values.

# ── Gemini ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# Phase 1 — text generation
GEMINI_MODEL=gemini-2.5-flash

# Phase 2 — live/audio session
GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-latest

# ── Firebase ───────────────────────────────────────────────────────────────────
# Local dev: path to your Firebase service account JSON file (relative to project root)
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# Cloud deploy (Railway etc.): paste the full contents of firebase-service-account.json here.
# If this is set, FIREBASE_CREDENTIALS_PATH is ignored.
# How to get it: cat firebase-service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_JSON=

FIREBASE_PROJECT_ID=your_firebase_project_id

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
# On Railway, $PORT is set automatically — leave PORT unset or use Railway's env var
PORT=8765
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# ── TTS ────────────────────────────────────────────────────────────────────────
# false → TTS is skipped, messages are sent instantly (recommended for now)
# true  → Gemini TTS is sent over WebSocket (adds latency)
ENABLE_TTS=true
