# ─── FRIDAY Backend — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env

# ── Gemini ─────────────────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Text model for Phase 1 (fast, cheap)
GEMINI_TEXT_MODEL=gemini-2.0-flash

# Live/audio model reserved for Phase 2
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001

# ── Firebase ───────────────────────────────────────────────────────────────────
# 1. Go to Firebase Console → Project Settings → Service Accounts
# 2. Click "Generate new private key" → download JSON
# 3. Place the file in friday-server/ and set the path below
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# Your Firebase project ID (shown in Project Settings → General)
FIREBASE_PROJECT_ID=your_firebase_project_id

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8765

# Comma-separated list of allowed CORS origins
# For local dev:
ALLOWED_ORIGINS=http://localhost:3000
# For production (add your domain):
# ALLOWED_ORIGINS=http://localhost:3000,https://friday.yourdomain.com
